<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/llAssistantBubbleRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="4dp"
    android:paddingEnd="48dp"
    android:paddingBottom="4dp">

    <!-- Bubble Container -->
    <LinearLayout
        android:id="@+id/llAssistantBubbleContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chat_bubble_assistant"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Header: Model Label and Download Icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBotBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bot:"
                android:textColor="#333333"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/btnDownloadImageTiny"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Save Image"
                android:src="@drawable/ic_aspect_ratio"
                android:visibility="gone"
                app:tint="@color/text_muted" />
        </LinearLayout>

        <!-- Markdown Formatted Text Body -->
        <TextView
            android:id="@+id/tvAssistantMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/chat_assistant_bubble_text"
            android:textSize="15sp" />

        <!-- Generated Image Container (For Image Models) -->
        <ImageView
            android:id="@+id/ivGeneratedImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:adjustViewBounds="true"
            android:contentDescription="AI Generated Image"
            android:maxHeight="300dp"
            android:visibility="gone" />

        <!-- Dynamic Container for Syntax Highlighted Code Blocks -->
        <LinearLayout
            android:id="@+id/llCodeBlocksContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <!-- Google Search Grounding Citations Chips List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvGroundingCitations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:visibility="gone" />

        <!-- Action Row (Copy, Speak, Regenerate, Delete) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAssistantTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12:00"
                android:textColor="@color/text_muted"
                android:textSize="10sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Copy -->
            <ImageView
                android:id="@+id/btnCopyAssistant"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Copy"
                android:padding="2dp"
                android:src="@drawable/ic_copy"
                app:tint="@color/text_muted" />

            <!-- Speak (TTS) with Orbiting Stars (Positioned on Circular Perimeter) -->
            <FrameLayout
                android:id="@+id/flSpeakAssistantContainer"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp">

                <ImageView
                    android:id="@+id/btnSpeakAssistant"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Speak"
                    android:padding="2dp"
                    android:src="@drawable/ic_speaker"
                    app:tint="@color/text_muted" />

                <!-- Star 1 (Top Center: 12 o'clock) -->
                <TextView
                    android:id="@+id/orbitStar1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="2dp"
                    android:text="✦"
                    android:textColor="#1a73e8"
                    android:textSize="11sp"
                    android:visibility="invisible" />

                <!-- Star 2 (Bottom Right: 4 o'clock) -->
                <TextView
                    android:id="@+id/orbitStar2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="3dp"
                    android:layout_marginBottom="4dp"
                    android:text="✦"
                    android:textColor="#1a73e8"
                    android:textSize="10sp"
                    android:visibility="invisible" />

                <!-- Star 3 (Bottom Left: 8 o'clock) -->
                <TextView
                    android:id="@+id/orbitStar3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="3dp"
                    android:layout_marginBottom="4dp"
                    android:text="✦"
                    android:textColor="#1a73e8"
                    android:textSize="9sp"
                    android:visibility="invisible" />
            </FrameLayout>

            <!-- Regenerate -->
            <ImageView
                android:id="@+id/btnRegenerateAssistant"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Regenerate"
                android:padding="2dp"
                android:src="@drawable/ic_regenerate"
                app:tint="@color/text_muted" />

            <!-- Delete -->
            <ImageView
                android:id="@+id/btnDeleteTurn"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Delete"
                android:padding="2dp"
                android:src="@drawable/ic_stop"
                app:tint="@color/text_muted" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>