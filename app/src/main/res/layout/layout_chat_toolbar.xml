<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/toolbarContainer"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:background="@color/header_dark"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <!-- Hamburger Drawer Icon -->
    <ImageView
        android:id="@+id/btnDrawerOpen"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Navigation Drawer"
        android:padding="10dp"
        android:src="@drawable/ic_dashboard"
        android:tint="@color/white" />

    <!-- App Title -->
    <TextView
        android:id="@+id/tvAppTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:text="Puter Unofficial"
        android:textColor="@color/white"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- Active Model Pill Badge (Clickable to change model) -->
    <TextView
        android:id="@+id/badgeActiveModel"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_pill_badge"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="gpt-4o-mini"
        android:textColor="@color/puter_blue"
        android:textSize="11sp"
        android:textStyle="bold" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <!-- Gemini Grounding Pill Switch -->
    <LinearLayout
        android:id="@+id/pillGroundingToggle"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_pill_badge"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Search"
            android:textColor="@color/puter_blue"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Live Voice Orb Button in Toolbar -->
    <ImageView
        android:id="@+id/btnToolbarVoiceOrb"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginEnd="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Live Voice Agent"
        android:padding="8dp"
        android:src="@drawable/ic_sparkle_agent"
        android:tint="@color/white" />

    <!-- New Chat Icon -->
    <ImageView
        android:id="@+id/btnToolbarNewChat"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginEnd="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="New Chat"
        android:padding="8dp"
        android:src="@drawable/ic_apps"
        android:tint="@color/white" />

    <!-- Three-dot Overflow Menu -->
    <ImageView
        android:id="@+id/btnToolbarOverflow"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="More Options"
        android:padding="8dp"
        android:src="@drawable/ic_settings"
        android:tint="@color/white" />

</LinearLayout>
