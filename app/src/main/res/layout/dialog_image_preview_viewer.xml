<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#e6000000">

    <!-- Top Action Bar -->
    <LinearLayout
        android:id="@+id/llImagePreviewTopBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/tvImagePreviewTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Image Preview"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSaveImageToGallery"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/puter_blue"
            android:text="Save"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnShareImage"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#444444"
            android:text="Share"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/btnCloseImagePreview"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:padding="6dp"
            android:src="@drawable/ic_stop"
            android:tint="@color/white" />
    </LinearLayout>

    <!-- Center Preview ImageView -->
    <ImageView
        android:id="@+id/ivFullPreviewImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/llImagePreviewTopBar"
        android:adjustViewBounds="true"
        android:contentDescription="Preview Image"
        android:scaleType="fitCenter" />

</RelativeLayout>
