<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ffffff"
    android:orientation="vertical">

    <!-- Top Blue Close Bar (Full-Bleed Edge-to-Edge) -->
    <Button
        android:id="@+id/btnAuthCloseBar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:backgroundTint="#1a73e8"
        android:elevation="4dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:stateListAnimator="@null"
        android:text="CLOSE WINDOW (TAP WHEN SIGNED IN)"
        android:textColor="#ffffff"
        android:textSize="13sp"
        android:textStyle="bold"
        app:cornerRadius="0dp" />

    <!-- Auth WebView (Properly Constrained Viewport) -->
    <android.webkit.WebView
        android:id="@+id/wvAuthPopup"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never" />

</LinearLayout>