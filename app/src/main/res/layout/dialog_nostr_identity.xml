<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_code_block"
    android:backgroundTint="#ffffff"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_fingerprint"
            app:tint="#1a73e8" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Nostr Identity"
            android:textColor="#333333"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="#eeeeee" />

    <!-- Card 1: Public Key (npub) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#f8f9fa"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Public ID (npub)"
            android:textColor="#555555"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNostrNpub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:fontFamily="monospace"
            android:text="Loading..."
            android:textColor="#333333"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnCopyNpub"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:backgroundTint="#1a73e8"
            android:text="Copy npub"
            android:textColor="#ffffff"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Card 2: Private Key (nsec) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#f8f9fa"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Private Key (nsec)"
            android:textColor="#555555"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNostrNsec"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:fontFamily="monospace"
            android:text="Loading..."
            android:textColor="#333333"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnCopyNsec"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:backgroundTint="#1a73e8"
            android:text="Copy nsec"
            android:textColor="#ffffff"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Bottom Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnNostrBack"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:backgroundTint="#eeeeee"
            android:text="Back"
            android:textColor="#333333"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnNostrDone"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:backgroundTint="#1a73e8"
            android:text="Done"
            android:textColor="#ffffff"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
