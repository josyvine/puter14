<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/liveVoiceHudRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f2000000"
    android:clickable="true"
    android:focusable="true">

    <!-- Top Status Bar in HUD -->
    <TextView
        android:id="@+id/tvLiveVoiceAgentTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/voice_agent_title"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvLiveVoiceStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/voice_status_listening"
        android:textColor="#a0c2f9"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvLiveVoiceAgentTitle" />

    <!-- Center Pulsing Voice Orb Container -->
    <FrameLayout
        android:id="@+id/flVoiceOrbContainer"
        android:layout_width="160dp"
        android:layout_height="160dp"
        app:layout_constraintBottom_toTopOf="@id/tvLiveTranscriptTicker"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvLiveVoiceStatus">

        <!-- Glowing Outer Pulse Ring -->
        <View
            android:id="@+id/viewOrbGlow"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:background="@drawable/bg_pill_badge"
            android:backgroundTint="#331a73e8" />

        <!-- Core Animated Orb -->
        <View
            android:id="@+id/viewOrbCore"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_pill_badge"
            android:backgroundTint="@color/puter_blue" />

        <!-- Orbiting Sparkle Star 1 -->
        <TextView
            android:id="@+id/tvStar1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:text="✦"
            android:textColor="#ffffff"
            android:textSize="16sp" />

        <!-- Orbiting Sparkle Star 2 -->
        <TextView
            android:id="@+id/tvStar2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="16dp"
            android:text="✦"
            android:textColor="#a0c2f9"
            android:textSize="14sp" />

        <!-- Orbiting Sparkle Star 3 -->
        <TextView
            android:id="@+id/tvStar3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:text="✦"
            android:textColor="#ffffff"
            android:textSize="14sp" />
    </FrameLayout>

    <!-- Real-time Speech Transcript Ticker -->
    <TextView
        android:id="@+id/tvLiveTranscriptTicker"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:maxLines="5"
        android:text="@string/voice_transcript_hint"
        android:textColor="#ffffff"
        android:textSize="15sp"
        app:layout_constraintBottom_toTopOf="@id/llLiveVoiceControls"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Bottom Controls in Voice HUD -->
    <LinearLayout
        android:id="@+id/llLiveVoiceControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Mic Mute Toggle -->
        <ImageView
            android:id="@+id/btnLiveMicMute"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_pill_badge"
            android:backgroundTint="#33ffffff"
            android:contentDescription="Mute Mic"
            android:padding="14dp"
            android:src="@drawable/ic_mic_pulse"
            android:tint="@color/white" />

        <!-- End Session Button -->
        <Button
            android:id="@+id/btnEndVoiceSession"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginStart="24dp"
            android:backgroundTint="@color/stop_red"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/voice_end_session"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
